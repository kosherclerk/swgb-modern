<Window x:Class="SWGBModern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SWGB Modern" Width="860" Height="700" MinWidth="760" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,16">
      <Grid>
        <StackPanel>
          <TextBlock Text="SWGB MODERN" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
          <TextBlock Text="Compatibility mod for Star Wars Galactic Battlegrounds" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <TextBlock Text="{Binding Version}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Muted}"/>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="16,8,16,0">
      <!-- PLAY -->
      <TabItem Header="Play">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="GAME"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Version to launch"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Name" SelectedValuePath="ExePath" HorizontalAlignment="Left" MinWidth="360"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsExpandingFronts, Converter={StaticResource Vis}}"
                       Text="Expanding Fronts keeps its own widescreen and 60 FPS options (in EF's Configurator). Leave EF's 'Window Mode' off: SWGB Modern provides the renderer, window modes, audio and volume fixes."/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Game folder"/>
              <TextBox Grid.Column="1" Text="{Binding GameDir, Mode=OneWay}" IsReadOnly="True"/>
              <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
            <TextBlock Style="{StaticResource Section}" Text="MOD STATUS"/>
            <TextBlock Text="{Binding InstallStateText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Install / Repair" Click="Install_Click"/>
              <Button Content="Uninstall" Click="Uninstall_Click"/>
              <Button Content="Open game folder" Click="OpenFolder_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="LAUNCH OPTIONS"/>
            <CheckBox Content="Play the intro videos" IsChecked="{Binding PlayIntro}"/>
            <CheckBox Content="Close the launcher when the game starts" IsChecked="{Binding CloseOnPlay}"/>
            <CheckBox Content="Use 4 GB memory mode (Large Address Aware copy of the game executable)" IsChecked="{Binding LargeAddressAware}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Creates '&lt;game&gt;.4gb.exe' next to the original and launches that instead. The original executable is never modified. Windows Firewall may ask once for the new file."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- COMPONENTS -->
      <TabItem Header="Components">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="PROFILE"/>
            <TextBlock><Run Text="Current: "/><Run Text="{Binding ProfileText, Mode=OneWay}" Foreground="{StaticResource Accent}"/></TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Faithful (original look)" Click="ProfileFaithful_Click"/>
              <Button Content="Enhanced (all improvements)" Click="ProfileEnhanced_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="Profiles only set the switches below; you can still change any of them."/>

            <TextBlock Style="{StaticResource Section}" Text="CORE - always active, keeps the original look"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                       Text="Modern renderers (DirectDraw replacement) - borderless/windowed modes - correct mouse and text boxes at any scale - per-monitor DPI - no palette corruption or Alt+Tab crashes - CPU idle fix - local crash dumps."/>
            <CheckBox Content="SWGB Modern audio engine (WASAPI, high-quality resampling)" IsChecked="{Binding AudioEnabled}"/>
            <CheckBox Content="In-game volume sliders do not change the Windows volume" IsChecked="{Binding IsolateVolume}"/>
            <CheckBox Content="Play the intro videos (through the mod's renderer)" IsChecked="{Binding PlayIntro}"/>

            <TextBlock Style="{StaticResource Section}" Text="ENHANCEMENTS - optional, change the original look"/>
            <CheckBox Content="Widescreen battlefield (rebuilt command panel, set up on the Display tab)" IsChecked="{Binding EnhWidescreen}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6" Text="Multiplayer note: a wider screen shows more of the battlefield than players on original resolutions see."/>
            <CheckBox Content="Smooth rendering: battlefield redrawn up to 60 times per second (original 20). Game speed unchanged." IsChecked="{Binding EnhSmooth}"/>
            <CheckBox Content="Upscaling filter instead of plain pixels (choose the filter on the Display tab)" IsChecked="{Binding EnhFilter}"/>
            <CheckBox Content="Smooth text: anti-aliased interface fonts, like Expanding Fronts" IsChecked="{Binding HdText}"/>
            <CheckBox Content="Smooth fog of war: full detail, evenly darkened instead of the black checkerboard" IsChecked="{Binding SmoothFog}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- DISPLAY -->
      <TabItem Header="Display">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="RENDERER"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Graphics API"/>
              <ComboBox Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding Renderers}" SelectedValue="{Binding Renderer}"/>
              <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Window"/>
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding Modes}" SelectedValue="{Binding Mode}"/>
              <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Monitor" Visibility="{Binding MultiMonitor, Converter={StaticResource Vis}}"/>
              <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding Monitors}" SelectedValue="{Binding Monitor}"
                        Visibility="{Binding MultiMonitor, Converter={StaticResource Vis}}"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Automatic picks Direct3D 11 and falls back to OpenGL, D3D12, Vulkan, D3D10 and finally Software. Alt+Enter switches between windowed and borderless while playing. A renderer change applies the next time the game starts; filter, scaling, window mode, VSync and frame limit apply immediately when you press Save."/>

            <TextBlock Style="{StaticResource Section}" Text="RESOLUTION AND UI SCALE"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Resolution"/>
              <ComboBox Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding ResolutionModes}" SelectedValue="{Binding ResolutionMode}" MinWidth="320"/>
              <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Native resolution" Visibility="{Binding IsScaledResolution, Converter={StaticResource Vis}}"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsScaledResolution, Converter={StaticResource Vis}}">
                <ComboBox MinWidth="180" ItemsSource="{Binding NativeModes}" SelectedValue="{Binding NativeRes}"/>
                <StackPanel Orientation="Horizontal" Margin="10,3,0,3" Visibility="{Binding IsCustomNative, Converter={StaticResource Vis}}">
                  <TextBox Width="70" Text="{Binding NativeW, UpdateSourceTrigger=LostFocus}"/>
                  <TextBlock Text=" x " VerticalAlignment="Center"/>
                  <TextBox Width="70" Text="{Binding NativeH, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Scale" Visibility="{Binding IsScaledResolution, Converter={StaticResource Vis}}"/>
              <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" MinWidth="460" ItemsSource="{Binding ScaleChoices}" SelectedItem="{Binding SelectedScale}"
                        DisplayMemberPath="" SelectedValuePath="" Visibility="{Binding IsScaledResolution, Converter={StaticResource Vis}}"/>
              <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Size" Visibility="{Binding IsCustomResolution, Converter={StaticResource Vis}}"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3" Visibility="{Binding IsCustomResolution, Converter={StaticResource Vis}}">
                <TextBox Width="80" Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text=" x " VerticalAlignment="Center"/>
                <TextBox Width="80" Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Command panel"/>
              <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding PanelStyles}" SelectedValue="{Binding PanelStyle}"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding ResolutionSummary}"/>
            <TextBlock Style="{StaticResource Section}" Text="MOUSE-WHEEL ZOOM"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Zoom out"/>
              <ComboBox Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding ZoomChoices}" SelectedValue="{Binding ZoomOut}"/>
              <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Zoom in"/>
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding ZoomInChoices}" SelectedValue="{Binding ZoomIn}"
                       />
              <CheckBox Grid.Row="2" Grid.Column="1" Content="Stop at 100% when zooming through it" IsChecked="{Binding ZoomSnap}"
                       />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Zoom the battlefield with the mouse wheel, like newer RTS games (widescreen only). Zooming out shows more of the map; the game then draws a larger battlefield, which costs more CPU. The original sprites are only scaled, not redrawn."/>

            <TextBlock Style="{StaticResource Section}" Text="SCALING"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Fit"/>
              <ComboBox Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding ScaleModes}" SelectedValue="{Binding ScaleMode}"/>
              <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Upscaling filter"/>
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding Filters}" SelectedValue="{Binding Filter}" MinWidth="320"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Nearest is lossless and exact at integer scales. Sharp keeps pixels crisp and only blends the edges where the scale is not a whole number. Bilinear is soft. The game's sprites are drawn at fixed pixel sizes by the engine, so all upscaling is applied to the finished image."/>

            <TextBlock Style="{StaticResource Section}" Text="TIMING"/>
            <CheckBox Content="VSync (no tearing; also caps to the monitor refresh rate)" IsChecked="{Binding VSync}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Style="{StaticResource Label}" Text="Frame rate limit (0 = refresh rate)" Width="240"/>
              <TextBox Width="70" Text="{Binding MaxFps, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <CheckBox Content="Keep the mouse inside the game while it is focused" IsChecked="{Binding LockCursor}" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- AUDIO -->
      <TabItem Header="Audio">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="AUDIO ENGINE"/>
            <CheckBox Content="Use the SWGB Modern audio engine (WASAPI, 32-bit float mixing)" IsChecked="{Binding AudioEnabled}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Replaces DirectSound. Sound effects and music are mixed at your device's native rate with high-quality resampling and a soft limiter instead of hard clipping. Follows the Windows default output device."/>
            <Grid IsEnabled="{Binding AudioEnabled}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Label}" Text="Resampler"/>
              <ComboBox Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding Resamplers}" SelectedValue="{Binding Resampler}"/>
              <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Master volume"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                <Slider Minimum="0" Maximum="200" TickFrequency="5" Value="{Binding Volume}"/>
                <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Latency"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Latency}"/>
                <TextBlock Text="{Binding Latency, StringFormat={}{0} ms}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <CheckBox Content="Soft limiter (prevents harsh clipping when many sounds overlap)" IsChecked="{Binding Limiter}" IsEnabled="{Binding AudioEnabled}"/>
            <TextBlock Style="{StaticResource Section}" Text="VOLUME SLIDERS"/>
            <CheckBox Content="Keep in-game volume sliders from changing the Windows volume" IsChecked="{Binding IsolateVolume}"/>
            <TextBlock Style="{StaticResource Hint}" Text="The game drives its sliders through the legacy Windows mixer, which changes your system volume. This routes them to the game's own music and sound volume instead."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- FIXES -->
      <TabItem Header="Fixes">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="SMOOTHNESS"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Label}" Text="Game redraw rate (fps)" Width="200"/>
              <TextBox Width="70" Text="{Binding GameFps, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="The original engine redraws the battlefield 20 times per second (10 for the main view). This only adds frames: the simulation advances by real time, so game speed is unchanged (measured: identical in-game clock at 15, 20 and 60 fps). 20 = original behaviour."/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Label}" Text="Minimap refresh (ms)" Width="200"/>
              <TextBox Width="70" Text="{Binding MinimapMs, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="Original: 333 ms."/>
            <TextBlock Style="{StaticResource Section}" Text="SYSTEM"/>
            <CheckBox Content="Reduce CPU usage when idle (the original game spins a CPU core at 100%)" IsChecked="{Binding IdleCpu}"/>
            <CheckBox Content="Write crash dumps to Game\CrashDumps (local only, never uploaded)" IsChecked="{Binding CrashDumps}"/>
            <CheckBox Content="Write a diagnostic log (SWGBModern.log)" IsChecked="{Binding Log}"/>
            <TextBlock Style="{StaticResource Section}" Text="MULTIPLAYER"/>
            <TextBlock><Run Text="DirectPlay: "/><Run Text="{Binding DirectPlayText, Mode=OneWay}"/></TextBlock>
            <Button Content="Enable DirectPlay (Windows feature, asks for administrator)" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Visibility="{Binding DirectPlayMissing, Converter={StaticResource Vis}}" Click="DirectPlay_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- MOD -->
      <TabItem Header="Mod">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="UPDATES"/>
            <CheckBox Content="Check for updates when the launcher starts" IsChecked="{Binding CheckUpdates}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Check for updates now" Click="Update_Click"/>
              <Button Content="Choose version..." Click="Versions_Click"/>
              <Button Content="Project page" Click="Project_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="DIAGNOSTICS"/>
            <CheckBox Content="Diagnostics: detailed log and the capture key" IsChecked="{Binding Diagnostics}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6" TextWrapping="Wrap" Text="While playing, press Ctrl+Shift+F12 to save the 3 seconds before and after as a video, stills and a screenshot, plus a summary with stats and the log. The log gets one line per second with frame rates, stutters, CPU and memory. Uses a little extra CPU while on."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Button Content="Open captures" Click="OpenCaptures_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="TROUBLESHOOTING"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Open log" Click="OpenLog_Click"/>
              <Button Content="Open crash dumps" Click="OpenDumps_Click"/>
              <Button Content="Reset settings" Click="Reset_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="ABOUT"/>
            <TextBlock Style="{StaticResource Hint}" Text="SWGB Modern replaces DirectDraw and DirectSound with modern renderers and audio, adds true widescreen and smoother rendering, and fixes compatibility issues. Original game files are never modified; uninstalling restores everything. Not affiliated with Lucasfilm, LucasArts, Disney or GOG. Star Wars Galactic Battlegrounds is required."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- footer -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,180,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Save" Click="Save_Click"/>
          <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Content="PLAY" Click="Play_Click" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
